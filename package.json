{
  "name": "foxseed-ar",
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "d1:generate": "drizzle-kit generate",
    "d1:migrate": "drizzle-kit migrate",
    "cf-typegen": "wrangler types",
    "type:check": "tsc --noEmit",
    "style:check": "biome check .",
    "lint": "npm run type:check && npm run style:check",
    "format": "biome format . --write"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.5.0",
    "@tailwindcss/vite": "^4.1.5",
    "@tweenjs/tween.js": "^23.1.3",
    "@types/tween.js": "^18.5.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.11.4",
    "hono": "^4.12.12",
    "mind-ar": "^1.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.5",
    "three": "^0.161.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@cloudflare/vite-plugin": "^1.1.0",
    "@cloudflare/workers-types": "^4.20250506.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.161.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.10",
    "globals": "^16.0.0",
    "typescript": "~5.7.2",
    "vite": "^7.3.2",
    "wrangler": "^4.14.1"
  }
}
